# Public site URL used for canonical links, sitemap.xml, robots.txt, and
# Open Graph metadata. Set this to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Analytics 4 Measurement ID. When unset, no analytics
# script is ever loaded and trackEvent() calls are silent no-ops — the site
# ships tracking-free by default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: webhook URL that receives quote-request and career-interest
# leads as a JSON POST (see src/lib/notify.ts). Point this at a CRM inbound
# webhook, Zapier/Make, or an email-relay endpoint. When unset, leads are
# only logged to the server console — safe for local development, but leads
# will NOT reach anyone in production until this is configured.
NOTIFY_WEBHOOK_URL=

# --- Payload CMS (required) ---
# Postgres connection string. Leads, content, and the admin dashboard will
# not work without a real database. See DEPLOYMENT.md for provisioning
# notes (e.g. a managed Postgres instance on Vercel, Neon, Supabase, or RDS).
DATABASE_URI=

# Long random secret used to sign Payload's auth tokens. Generate one with:
#   openssl rand -hex 32
# Never reuse the development value committed anywhere in this repo's
# history — treat it as compromised and rotate before going to production.
PAYLOAD_SECRET=

# Absolute URL Payload uses internally for server-to-server calls
# (e.g. https://your-domain.com). Usually the same as NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SERVER_URL=

# Used only by `npm run seed` to create the first super-admin user when no
# users exist yet. Not read at request time — safe to unset after the first
# seed run, but keep them out of version control regardless.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# --- Optional: S3-compatible media storage ---
# When unset, uploaded media is written to local disk (public/media), which
# is fine for local development but does NOT persist across deployments on
# most hosting platforms. Set these before going to production.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Optional: transactional email ---
# When unset, Payload logs emails (password resets, etc.) to the server
# console instead of sending them.
SMTP_HOST=
RESEND_API_KEY=
