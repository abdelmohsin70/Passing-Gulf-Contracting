# Public site URL used for canonical links, sitemap.xml, robots.txt, and
# Open Graph metadata. Set this to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Analytics 4 Measurement ID. When unset, no analytics
# script is ever loaded and trackEvent() calls are silent no-ops — the site
# ships tracking-free by default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: webhook URL that receives quote-request and career-interest
# leads as a JSON POST (see src/lib/notify.ts). Point this at a CRM inbound
# webhook, Zapier/Make, or an email-relay endpoint. When unset, leads are
# only logged to the server console — safe for local development, but leads
# will NOT reach anyone in production until this is configured.
NOTIFY_WEBHOOK_URL=
